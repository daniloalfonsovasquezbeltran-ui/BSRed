# Configurar el valor real de forma privada; no subirlo a Git.
DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST:PUERTO/BASE

PUBLIC_BASE_URL=https://bsred.onrender.com

# Opcionales: completar de forma privada para activar recuperación por correo.
# Ver docs/activar-servicios.md. Nunca añadir las claves reales a este archivo.
# Gmail API: autorizar la cuenta remitente con el permiso gmail.send.
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# MAIL_FROM_EMAIL=bsredpanguipulli@gmail.com
# MAIL_FROM_NAME=BSRed
# Alternativa con dominio propio autenticado en Brevo.
# BREVO_API_KEY=

# Opcionales: configuración pública del cliente Android registrado en Firebase.
# ANDROID_FIREBASE_PROJECT_ID=
# ANDROID_FIREBASE_SENDER_ID=
# ANDROID_FIREBASE_APP_ID=
# ANDROID_FIREBASE_API_KEY=
# FCM_SERVICE_ACCOUNT_JSON=

# Web Push: conservar las claves ya usadas por los dispositivos suscritos.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:bsredpanguipulli@gmail.com
# NOTIFICATION_CRON_TOKEN=
# NOTIFICATIONS_SCHEDULER_ENABLED=false
